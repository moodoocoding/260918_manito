{
  "name": "manitto-classroom",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "build": "npm --workspace functions run build",
    "deploy:backend": "node scripts/deploy-backend.mjs",
    "emulators": "firebase emulators:start --project demo-manitto",
    "test:functions": "npm --workspace functions test",
    "test:integration": "npm run build && firebase emulators:exec --project demo-manitto --only auth,firestore,functions \"node --test tests/functions.integration.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-manitto --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.30.2"
  }
}
